<Solution>
  <!--
    Development solution for this repository: the template projects + the cleanslices CLI + template configs.
    Not part of the template (excluded in .template.config/template.json). Generated solutions get CleanSlices.slnx.
  -->
  <Folder Name="/aspire/">
    <Project Path="aspire/CleanSlices.AppHost/CleanSlices.AppHost.csproj" />
    <Project Path="aspire/CleanSlices.ServiceDefaults/CleanSlices.ServiceDefaults.csproj" />
  </Folder>
  <Folder Name="/src/">
    <Project Path="src/CleanSlices.Api/CleanSlices.Api.csproj" />
    <Project Path="src/CleanSlices.Core/CleanSlices.Core.csproj" />
    <Project Path="src/CleanSlices.Infrastructure/CleanSlices.Infrastructure.csproj" />
  </Folder>
  <Folder Name="/tests/">
    <Project Path="tests/CleanSlices.Api.Tests/CleanSlices.Api.Tests.csproj" />
    <Project Path="tests/CleanSlices.Core.Tests/CleanSlices.Core.Tests.csproj" />
  </Folder>
  <Folder Name="/cli/">
    <Project Path="cli/CleanSlices.Cli/CleanSlices.Cli.csproj" />
    <File Path="cli/Directory.Build.props" />
    <File Path="cli/Directory.Packages.props" />
  </Folder>
  <Folder Name="/templates/">
    <File Path=".template.config/template.json" />
  </Folder>
  <Folder Name="/templates/cs-feature/">
    <File Path="templates/cs-feature/.template.config/template.json" />
  </Folder>
  <Folder Name="/templates/cs-feature/Api/">
    <File Path="templates/cs-feature/src/CleanSlices.Api/Features/Widgets/CreateWidget.cs" />
    <File Path="templates/cs-feature/src/CleanSlices.Api/Features/Widgets/DeleteWidget.cs" />
    <File Path="templates/cs-feature/src/CleanSlices.Api/Features/Widgets/GetWidgetById.cs" />
    <File Path="templates/cs-feature/src/CleanSlices.Api/Features/Widgets/GetWidgets.cs" />
    <File Path="templates/cs-feature/src/CleanSlices.Api/Features/Widgets/UpdateWidgetName.cs" />
    <File Path="templates/cs-feature/src/CleanSlices.Api/Features/Widgets/WidgetErrors.cs" />
  </Folder>
  <Folder Name="/templates/cs-feature/Core/">
    <File Path="templates/cs-feature/src/CleanSlices.Core/Domain/Widgets/Widget.cs" />
    <File Path="templates/cs-feature/src/CleanSlices.Core/Domain/Widgets/WidgetDomainEvents.cs" />
    <File Path="templates/cs-feature/src/CleanSlices.Core/Domain/Widgets/WidgetErrors.cs" />
  </Folder>
  <Folder Name="/templates/cs-feature/Tests/">
    <File Path="templates/cs-feature/tests/CleanSlices.Api.Tests/Features/Widgets/WidgetEndpointsTests.cs" />
    <File Path="templates/cs-feature/tests/CleanSlices.Core.Tests/Domain/Widgets/WidgetTests.cs" />
  </Folder>
  <Folder Name="/templates/cs-feature/Infrastructure/">
    <File Path="templates/cs-feature/src/CleanSlices.Infrastructure/EventHandlers/Widgets/WidgetCreatedEventHandler.cs" />
    <File Path="templates/cs-feature/src/CleanSlices.Infrastructure/EventHandlers/Widgets/WidgetDeletedEventHandler.cs" />
    <File Path="templates/cs-feature/src/CleanSlices.Infrastructure/Persistence/Configuration/WidgetTypeConfiguration.cs" />
  </Folder>
  <Folder Name="/Solution Items/">
    <File Path=".editorconfig" />
    <File Path=".gitignore" />
    <File Path="CleanSlices.slnx" />
    <File Path="CONTRIBUTING.md" />
    <File Path="docs/CLI.md" />
    <File Path="Directory.Build.props" />
    <File Path="Directory.Packages.props" />
    <File Path="global.json" />
    <File Path="README.md" />
  </Folder>
</Solution>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>CleanSlices.Cli</RootNamespace>

    <PackAsTool>true</PackAsTool>
    <ToolCommandName>cleanslices</ToolCommandName>
    <PackageId>CleanSlices.Cli</PackageId>
    <Version>0.2.0</Version>
    <Authors>Steve</Authors>
    <Description>Interactive scaffolding for Clean Slices solutions (wraps the cleanslices / cs-feature dotnet new templates).</Description>
    <PackageOutputPath>$(MSBuildThisFileDirectory)..\artifacts</PackageOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Spectre.Console" />
    <PackageReference Include="Spectre.Console.Cli" />
  </ItemGroup>

</Project>

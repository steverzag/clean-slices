<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>CleanSlices.Cli</RootNamespace>

    <PackAsTool>true</PackAsTool>
    <ToolCommandName>cleanslices</ToolCommandName>
    <PackageId>CleanSlices.Cli</PackageId>
    <Version>0.4.0</Version>
    <Authors>Steve</Authors>
    <Description>Creates Clean Slices solutions with the options you pick, adds features that follow them, and merges more options into existing code.</Description>
    <PackageOutputPath>$(MSBuildThisFileDirectory)..\artifacts</PackageOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Spectre.Console" />
    <PackageReference Include="Spectre.Console.Cli" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CleanSlices.Cli.Tests" />
    <InternalsVisibleTo Include="CleanSlices.Matrix" />
  </ItemGroup>

</Project>

<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup Label="ASP.NET Core">
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    <!--#if (validation)-->
    <PackageVersion Include="FluentValidation.DependencyInjectionExtensions" Version="12.2.0" />
    <!--#endif-->
    <!--#if (cqrs && mediator)-->
    <PackageVersion Include="Mediator.Abstractions" Version="3.0.2" />
    <PackageVersion Include="Mediator.SourceGenerator" Version="3.0.2" />
    <!--#endif-->
    <!--#if (scalar)-->
    <PackageVersion Include="Scalar.AspNetCore" Version="2.19.0" />
    <!--#endif-->
    <!--#if (serilog)-->
    <PackageVersion Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageVersion Include="Serilog.Sinks.OpenTelemetry" Version="4.2.0" />
    <!--#endif-->
    <!--#if (serilog && seq)-->
    <PackageVersion Include="Serilog.Sinks.Seq" Version="9.1.0" />
    <!--#endif-->
    <!--#if (signalr_redis)-->
    <PackageVersion Include="Microsoft.AspNetCore.SignalR.StackExchangeRedis" Version="10.0.14" />
    <!--#endif-->
    <!--#if (keycloak || entra)-->
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.14" />
    <!--#endif-->
  </ItemGroup>

  <ItemGroup Label="Entity Framework Core">
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.14" />
    <!--#if (identity)-->
    <PackageVersion Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.14" />
    <!--#endif-->
    <!--#if (postgresql)-->
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageVersion Include="EFCore.NamingConventions" Version="10.0.1" />
    <!-- Npgsql depends on an older EF Core relational package; keep it in step with EF Core above. -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.14" />
    <!--#else-->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.14" />
    <!--#endif-->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup Label="Aspire integrations">
    <!--#if (postgresql)-->
    <PackageVersion Include="Aspire.Hosting.PostgreSQL" Version="13.6.1" />
    <PackageVersion Include="Aspire.Npgsql.EntityFrameworkCore.PostgreSQL" Version="13.6.1" />
    <!--#else-->
    <PackageVersion Include="Aspire.Hosting.SqlServer" Version="13.6.1" />
    <PackageVersion Include="Aspire.Microsoft.EntityFrameworkCore.SqlServer" Version="13.6.1" />
    <!--#endif-->
    <!--#if (redis)-->
    <PackageVersion Include="Aspire.Hosting.Redis" Version="13.6.1" />
    <PackageVersion Include="Aspire.StackExchange.Redis.DistributedCaching" Version="13.6.1" />
    <!--#endif-->
    <!--#if (rabbitmq)-->
    <PackageVersion Include="Aspire.Hosting.RabbitMQ" Version="13.6.1" />
    <PackageVersion Include="Aspire.RabbitMQ.Client" Version="13.6.1" />
    <!--#endif-->
    <!--#if (serilog && seq)-->
    <PackageVersion Include="Aspire.Hosting.Seq" Version="13.6.1" />
    <!--#endif-->
    <!--#if (servicebus)-->
    <PackageVersion Include="Aspire.Hosting.Azure.ServiceBus" Version="13.6.1" />
    <PackageVersion Include="Aspire.Azure.Messaging.ServiceBus" Version="13.6.1" />
    <!--#endif-->
  </ItemGroup>

  <ItemGroup Label="Caching">
    <!--#if (hybrid_cache && !fusioncache)-->
    <PackageVersion Include="Microsoft.Extensions.Caching.Hybrid" Version="10.11.0" />
    <!--#endif-->
    <!--#if (fusioncache)-->
    <PackageVersion Include="ZiggyCreatures.FusionCache" Version="2.9.0" />
    <!--#endif-->
    <!--#if (fusioncache_redis)-->
    <PackageVersion Include="ZiggyCreatures.FusionCache.Serialization.SystemTextJson" Version="2.9.0" />
    <PackageVersion Include="ZiggyCreatures.FusionCache.Backplane.StackExchangeRedis" Version="2.9.0" />
    <!--#endif-->
  </ItemGroup>

  <ItemGroup Label="Aspire / Service Defaults">
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.10.0" />
    <PackageVersion Include="Microsoft.Extensions.ServiceDiscovery" Version="10.10.0" />
  </ItemGroup>

  <ItemGroup Label="OpenTelemetry">
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.17.0" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.17.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.17.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.17.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.17.0" />
  </ItemGroup>

  <ItemGroup Label="Testing">
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.14" />
    <!--#if (postgresql)-->
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.16.0" />
    <!--#else-->
    <PackageVersion Include="Testcontainers.MsSql" Version="4.16.0" />
    <!--#endif-->
    <!--#if (redis)-->
    <PackageVersion Include="Testcontainers.Redis" Version="4.16.0" />
    <!--#endif-->
    <!--#if (rabbitmq)-->
    <PackageVersion Include="Testcontainers.RabbitMq" Version="4.16.0" />
    <!--#endif-->
    <!--#if (servicebus)-->
    <PackageVersion Include="Testcontainers.ServiceBus" Version="4.16.0" />
    <!--#endif-->
    <!--#if (signalr)-->
    <PackageVersion Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.14" />
    <!--#endif-->
    <!--#if (keycloak)-->
    <PackageVersion Include="Testcontainers.Keycloak" Version="4.16.0" />
    <!--#endif-->
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
  </ItemGroup>

  <!-- Transitive pins: override vulnerable versions pulled in by other packages -->
  <ItemGroup Label="Security pins (transitive)">
    <!-- via Microsoft.EntityFrameworkCore.SqlServer; 9.0.11 has GHSA-846f-f764-76mx, GHSA-2fmv-rv2c-59x7 -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
    <!-- via Aspire.AppHost.Sdk; 2.5.302 has GHSA-qhrr-8q5h-9q3h -->
    <PackageVersion Include="MessagePack" Version="2.5.307" />
  </ItemGroup>
</Project>

{
  "$schema": "http://json.schemastore.org/template",
  "author": "Steve",
  "classifications": [ "Web", "API", "Aspire", "Clean Architecture", "Vertical Slices" ],
  "identity": "Steve.CleanSlices.Template",
  "name": "Clean Slices API",
  "description": "ASP.NET Core API with Clean Architecture + Vertical Slices, orchestrated with .NET Aspire.",
  "shortName": "cleanslices",
  "sourceName": "CleanSlices",
  "preferNameDirectory": true,
  "tags": {
    "language": "C#",
    "type": "solution"
  },
  "guids": [
    "385d530b-f969-4765-ac73-a898903aa161",
    "b5c156b9-1708-4850-b78a-797a5c345e4f"
  ],
  "forms": {
    "dotToUnderscore": { "identifier": "replace", "pattern": "\\.", "replacement": "_" },
    "appendUnderscore": { "identifier": "replace", "pattern": "$", "replacement": "_" },
    "dotToHyphen": { "identifier": "replace", "pattern": "\\.", "replacement": "-" },
    "appendHyphen": { "identifier": "replace", "pattern": "$", "replacement": "-" },
    "lower": { "identifier": "lowerCase" },
    "aspireProjectsPrefix": { "identifier": "chain", "steps": [ "dotToUnderscore", "appendUnderscore" ] },
    "aspireResourcePrefix": { "identifier": "chain", "steps": [ "lower", "dotToHyphen", "appendHyphen" ] }
  },
  "symbols": {
    "validation": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "false",
      "description": "Request validation: FluentValidation validators check the shape of requests before the handler; the domain stays the authority."
    },
    "repository": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "false",
      "description": "Repository / unit of work: handlers use repositories and IUnitOfWork defined in Core instead of AppDbContext."
    },
    "cqrs": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "false",
      "description": "CQRS: endpoints send commands and queries to handlers in the slice; queries read through IReadDb without tracking."
    },
    "cqrs_dispatcher": {
      "type": "parameter",
      "datatype": "choice",
      "defaultValue": "handlers",
      "choices": [
        { "choice": "handlers", "description": "Own handlers: a small dispatcher in the solution, no package." },
        { "choice": "mediator", "description": "The source-generated Mediator package (MIT), with the same interfaces." }
      ],
      "description": "Which dispatcher sends commands and queries to their handlers (only with cqrs)."
    },
    "handlers": {
      "type": "computed",
      "value": "(cqrs_dispatcher == \"handlers\")"
    },
    "mediator": {
      "type": "computed",
      "value": "(cqrs_dispatcher == \"mediator\")"
    },
    "idempotency": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "false",
      "description": "Idempotency keys: a retry with the same Idempotency-Key header gets the stored response instead of running the action again."
    },
    "current_user": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "false",
      "description": "Current user (added by the CLI when an option needs it): who makes the request, anonymous until an authentication option is selected."
    },
    "cache": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "false",
      "description": "Cache (added by the CLI when an option needs it): an in-memory distributed cache, replaced by the Redis option."
    },
    "samples": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "false",
      "description": "Include the sample Tasks/Users features (domain, endpoints, EF configuration, event handlers)."
    },
    "result": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "false",
      "description": "Result<T> pattern: domain methods return Result / Result<T> instead of throwing for expected failures."
    },
    "sqlserver": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "false",
      "description": "SQL Server (the default database): the code uses it unless another database is selected."
    },
    "postgresql": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "false",
      "description": "PostgreSQL instead of SQL Server, with snake_case names."
    },
    "redis": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "false",
      "description": "Redis behind IDistributedCache and HybridCache, shared by every instance; in a container from the AppHost."
    },
    "fusioncache": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "false",
      "description": "FusionCache runs HybridCache: fail-safe, timeouts, and with Redis a backplane."
    },
    "rabbitmq": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "false",
      "description": "Integration events go through RabbitMQ: sent after the commit (or by the outbox), retried, then dead-lettered."
    },
    "servicebus": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "false",
      "description": "Integration events go through an Azure Service Bus topic (the emulator locally): sent after the commit (or by the outbox), retried, then dead-lettered."
    },
    "message_broker": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "false",
      "description": "Message broker (added by the CLI with a queue option): what RabbitMQ and Service Bus share."
    },
    "hybrid_cache": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "false",
      "description": "HybridCache (added by the CLI when an option needs it): Microsoft's, or FusionCache when selected."
    },
    "after_commit": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "false",
      "description": "After commit (added by the CLI when an option needs it): work queued during a save runs once the data is committed."
    },
    "fusioncache_redis": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "false",
      "description": "FusionCache with Redis (added by the CLI): Redis as FusionCache's second level and its backplane."
    },
    "model_rules": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "false",
      "description": "Model rules (added by the CLI when an option needs them): rules applied to the whole EF model."
    },
    "integration_events": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "false",
      "description": "Integration events (added by the CLI when an option needs them): events for the outside world, handled after the save."
    },
    "outbox": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "false",
      "description": "Outbox pattern: integration events are stored with the data and delivered by a background processor, with retries."
    },
    "inbox": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "false",
      "description": "Inbox pattern: each integration event handler runs once per message, even when the message is delivered again."
    },
    "aspireProjectsPrefix": {
      "type": "derived",
      "valueSource": "name",
      "valueTransform": "aspireProjectsPrefix",
      "replaces": "CleanSlices_",
      "description": "Aspire generated Projects.* class prefix (dots -> underscores)."
    },
    "aspireResourcePrefix": {
      "type": "derived",
      "valueSource": "name",
      "valueTransform": "aspireResourcePrefix",
      "replaces": "cleanslices-",
      "description": "Aspire resource name prefix (lowercase, dots -> hyphens)."
    }
  },
  "sources": [
    {
      "copyOnly": [
        "docs/CLI.md"
      ],
      "modifiers": [
        {
          "exclude": [
            ".vs/**",
            "**/bin/**",
            "**/obj/**",
            "**/*.user",
            ".git/**",
            ".github/**",
            ".template.config/**",
            "templates/**",
            "cli/**",
            "CleanSlices.Dev.slnx",
            "CONTRIBUTING.md",
            "ROADMAP.md",
            "docs/roadmap/**",
            "catalog.json",
            "catalog.schema.json",
            "src/CleanSlices.Infrastructure/Migrations/**"
          ]
        },
        {
          "condition": "(!samples)",
          "exclude": [
            "src/CleanSlices.Api/Features/Tasks/**",
            "src/CleanSlices.Api/Features/Users/**",
            "src/CleanSlices.Core/Domain/Tasks/**",
            "src/CleanSlices.Core/Domain/Users/**",
            "src/CleanSlices.Infrastructure/EventHandlers/TaskItems/**",
            "src/CleanSlices.Infrastructure/EventHandlers/Users/**",
            "src/CleanSlices.Infrastructure/Persistence/Configuration/TaskItemTypeConfiguration.cs",
            "src/CleanSlices.Infrastructure/Persistence/Configuration/TaskItemUserAssignmentTypeConfiguration.cs",
            "src/CleanSlices.Infrastructure/Persistence/Configuration/UserTypeConfiguration.cs",
            "src/CleanSlices.Infrastructure/Persistence/Configuration/UserEmailCollationRule.cs",
            "tests/CleanSlices.Core.Tests/Domain/Tasks/**",
            "tests/CleanSlices.Core.Tests/Domain/Users/**",
            "tests/CleanSlices.Api.Tests/Features/Tasks/**",
            "tests/CleanSlices.Api.Tests/Features/Users/**",
            "src/CleanSlices.Infrastructure/IntegrationEvents/TaskItems/**",
            "src/CleanSlices.Infrastructure/IntegrationEvents/Users/**",
            "src/CleanSlices.Infrastructure/Persistence/Repositories/TaskItemRepository.cs",
            "src/CleanSlices.Infrastructure/Persistence/Repositories/UserRepository.cs",
            "docs/samples.md"
          ]
        },
        {
          "condition": "(!result)",
          "exclude": [
            "src/CleanSlices.Api/Extensions/ResultExtensions.cs",
            "src/CleanSlices.Core/Shared/Error.cs",
            "src/CleanSlices.Core/Shared/Result.cs",
            "tests/CleanSlices.Core.Tests/ResultAssertions.cs",
            "docs/error-handling.result.md"
          ]
        },
        {
          "condition": "(!validation)",
          "exclude": [
            "src/CleanSlices.Api/Configuration/Validation/**",
            "tests/CleanSlices.Api.Tests/Configuration/RequestValidationTests.cs",
            "docs/request-validation.md"
          ]
        },
        {
          "condition": "(!repository)",
          "exclude": [
            "src/CleanSlices.Core/Domain/IRepository.cs",
            "src/CleanSlices.Core/Domain/IUnitOfWork.cs",
            "src/CleanSlices.Core/Shared/Page.cs",
            "src/CleanSlices.Core/Domain/Users/IUserRepository.cs",
            "src/CleanSlices.Core/Domain/Tasks/ITaskItemRepository.cs",
            "src/CleanSlices.Infrastructure/Persistence/Repositories/**",
            "tests/CleanSlices.Api.Tests/Configuration/RepositoryRegistrationTests.cs",
            "docs/repository.md"
          ]
        },
        {
          "condition": "(!cqrs)",
          "exclude": [
            "src/CleanSlices.Api/Configuration/Cqrs/**",
            "src/CleanSlices.Core/Domain/IReadDb.cs",
            "docs/cqrs.md"
          ]
        },
        {
          "condition": "(!cqrs || !handlers)",
          "exclude": [
            "src/CleanSlices.Api/Configuration/Cqrs/Messages.cs",
            "src/CleanSlices.Api/Configuration/Cqrs/Sender.cs",
            "tests/CleanSlices.Api.Tests/Configuration/SenderTests.cs"
          ]
        },
        {
          "condition": "(!idempotency)",
          "exclude": [
            "src/CleanSlices.Api/Configuration/Idempotency/**",
            "tests/CleanSlices.Api.Tests/Configuration/IdempotencyTests.cs",
            "docs/idempotency.md"
          ]
        },
        {
          "condition": "(!current_user)",
          "exclude": [
            "src/CleanSlices.Infrastructure/CurrentUser/**"
          ]
        },
        {
          "condition": "(!message_broker)",
          "exclude": [
            "src/CleanSlices.Infrastructure/IntegrationEvents/Broker/**",
            "tests/CleanSlices.Api.Tests/IntegrationEvents/BrokerTests.cs",
            "docs/messaging.md"
          ]
        },
        {
          "condition": "(outbox)",
          "exclude": [
            "src/CleanSlices.Infrastructure/IntegrationEvents/Broker/AfterCommitPublisher.cs"
          ]
        },
        {
          "condition": "(!rabbitmq)",
          "exclude": [
            "src/CleanSlices.Infrastructure/IntegrationEvents/RabbitMq/**"
          ]
        },
        {
          "condition": "(!servicebus)",
          "exclude": [
            "src/CleanSlices.Infrastructure/IntegrationEvents/ServiceBus/**"
          ]
        },
        {
          "condition": "(!after_commit)",
          "exclude": [
            "src/CleanSlices.Infrastructure/Persistence/AfterCommit/**",
            "tests/CleanSlices.Api.Tests/Persistence/AfterCommitTests.cs"
          ]
        },
        {
          "condition": "(!hybrid_cache)",
          "exclude": [
            "src/CleanSlices.Infrastructure/EventHandlers/Users/ForgetCachedUserHandler.cs",
            "tests/CleanSlices.Api.Tests/Caching/**",
            "docs/caching.md"
          ]
        },
        {
          "condition": "(!model_rules)",
          "exclude": [
            "src/CleanSlices.Infrastructure/Persistence/ModelRules/**"
          ]
        },
        {
          "condition": "(!postgresql)",
          "exclude": [
            "src/CleanSlices.Infrastructure/Persistence/PostgreSql/**",
            "src/CleanSlices.Infrastructure/Persistence/Configuration/UserEmailCollationRule.cs",
            "src/CleanSlices.Api/appsettings.postgresql.json",
            "docs/database.postgresql.md"
          ]
        },
        {
          "condition": "(postgresql)",
          "exclude": [
            "src/CleanSlices.Api/appsettings.json",
            "docs/database.md"
          ],
          "rename": {
            "src/CleanSlices.Api/appsettings.postgresql.json": "src/CleanSlices.Api/appsettings.json",
            "docs/database.postgresql.md": "docs/database.md"
          }
        },
        {
          "condition": "(!integration_events)",
          "exclude": [
            "src/CleanSlices.Infrastructure/IntegrationEvents/**",
            "docs/integration-events.md",
            "tests/CleanSlices.Api.Tests/IntegrationEvents/**",
            "src/CleanSlices.Infrastructure/EventHandlers/TaskItems/PublishTaskCompletedHandler.cs",
            "src/CleanSlices.Infrastructure/EventHandlers/Users/PublishUserCreatedHandler.cs",
            "src/CleanSlices.Infrastructure/EventHandlers/Users/PublishUserDeletedHandler.cs"
          ]
        },
        {
          "condition": "(!outbox)",
          "exclude": [
            "src/CleanSlices.Infrastructure/Outbox/**",
            "docs/outbox.md",
            "tests/CleanSlices.Api.Tests/Outbox/**",
            "tests/CleanSlices.Api.Tests/Features/Tasks/TaskIntegrationEventsTests.cs",
            "tests/CleanSlices.Api.Tests/Features/Users/UserIntegrationEventsTests.cs"
          ]
        },
        {
          "condition": "(!inbox)",
          "exclude": [
            "src/CleanSlices.Infrastructure/Inbox/**",
            "docs/inbox.md",
            "tests/CleanSlices.Api.Tests/Inbox/**"
          ]
        },
        {
          "condition": "(result)",
          "exclude": [
            "src/CleanSlices.Core/Shared/Exceptions.cs",
            "docs/error-handling.md"
          ],
          "rename": {
            "docs/error-handling.result.md": "docs/error-handling.md"
          }
        }
      ]
    }
  ],
  "SpecialCustomOperations": {
    "**/*.md": {
      "operations": [
        {
          "type": "conditional",
          "configuration": {
            "if": [ "<!--#if" ],
            "else": [ "<!--#else" ],
            "elseif": [ "<!--#elseif" ],
            "endif": [ "<!--#endif" ],
            "trim": true,
            "wholeLine": true
          }
        }
      ]
    },
    "**/*.http": {
      "operations": [
        {
          "type": "conditional",
          "configuration": {
            "if": [ "# #if" ],
            "else": [ "# #else" ],
            "elseif": [ "# #elseif" ],
            "endif": [ "# #endif" ],
            "trim": true,
            "wholeLine": true
          }
        }
      ]
    }
  }
}

{
  "$schema": "http://json.schemastore.org/template",
  "author": "Steve",
  "classifications": [ "Web", "API", "Aspire", "Clean Architecture", "Vertical Slices" ],
  "identity": "Steve.CleanSlices.Template",
  "name": "Clean Slices API",
  "description": "ASP.NET Core API with Clean Architecture + Vertical Slices, orchestrated with .NET Aspire.",
  "shortName": "cleanslices",
  "sourceName": "CleanSlices",
  "preferNameDirectory": true,
  "tags": {
    "language": "C#",
    "type": "solution"
  },
  "guids": [
    "385d530b-f969-4765-ac73-a898903aa161",
    "b5c156b9-1708-4850-b78a-797a5c345e4f"
  ],
  "forms": {
    "dotToUnderscore": { "identifier": "replace", "pattern": "\\.", "replacement": "_" },
    "appendUnderscore": { "identifier": "replace", "pattern": "$", "replacement": "_" },
    "dotToHyphen": { "identifier": "replace", "pattern": "\\.", "replacement": "-" },
    "appendHyphen": { "identifier": "replace", "pattern": "$", "replacement": "-" },
    "lower": { "identifier": "lowerCase" },
    "aspireProjectsPrefix": { "identifier": "chain", "steps": [ "dotToUnderscore", "appendUnderscore" ] },
    "aspireResourcePrefix": { "identifier": "chain", "steps": [ "lower", "dotToHyphen", "appendHyphen" ] }
  },
  "symbols": {
    "samples": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "false",
      "description": "Include the sample Tasks/Users features (domain, endpoints, EF configuration, event handlers)."
    },
    "result": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "false",
      "description": "Result<T> pattern: domain methods return Result / Result<T> instead of throwing for expected failures."
    },
    "integration_events": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "false",
      "description": "Integration events (added by the CLI when an option needs them): events for the outside world, handled after the save."
    },
    "outbox": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "false",
      "description": "Outbox pattern: integration events are stored with the data and delivered by a background processor, with retries."
    },
    "inbox": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "false",
      "description": "Inbox pattern: each integration event handler runs once per message, even when the message is delivered again."
    },
    "aspireProjectsPrefix": {
      "type": "derived",
      "valueSource": "name",
      "valueTransform": "aspireProjectsPrefix",
      "replaces": "CleanSlices_",
      "description": "Aspire generated Projects.* class prefix (dots -> underscores)."
    },
    "aspireResourcePrefix": {
      "type": "derived",
      "valueSource": "name",
      "valueTransform": "aspireResourcePrefix",
      "replaces": "cleanslices-",
      "description": "Aspire resource name prefix (lowercase, dots -> hyphens)."
    }
  },
  "sources": [
    {
      "copyOnly": [
        "docs/CLI.md"
      ],
      "modifiers": [
        {
          "exclude": [
            ".vs/**",
            "**/bin/**",
            "**/obj/**",
            "**/*.user",
            ".git/**",
            ".github/**",
            ".template.config/**",
            "templates/**",
            "cli/**",
            "CleanSlices.Dev.slnx",
            "CONTRIBUTING.md",
            "ROADMAP.md",
            "docs/roadmap/**",
            "catalog.json",
            "catalog.schema.json",
            "src/CleanSlices.Infrastructure/Migrations/**"
          ]
        },
        {
          "condition": "(!samples)",
          "exclude": [
            "src/CleanSlices.Api/Features/Tasks/**",
            "src/CleanSlices.Api/Features/Users/**",
            "src/CleanSlices.Core/Domain/Tasks/**",
            "src/CleanSlices.Core/Domain/Users/**",
            "src/CleanSlices.Infrastructure/EventHandlers/TaskItems/**",
            "src/CleanSlices.Infrastructure/EventHandlers/Users/**",
            "src/CleanSlices.Infrastructure/Persistence/Configuration/TaskItemTypeConfiguration.cs",
            "src/CleanSlices.Infrastructure/Persistence/Configuration/TaskItemUserAssignmentTypeConfiguration.cs",
            "src/CleanSlices.Infrastructure/Persistence/Configuration/UserTypeConfiguration.cs",
            "tests/CleanSlices.Core.Tests/Domain/Tasks/**",
            "tests/CleanSlices.Core.Tests/Domain/Users/**",
            "tests/CleanSlices.Api.Tests/Features/Tasks/**",
            "tests/CleanSlices.Api.Tests/Features/Users/**",
            "src/CleanSlices.Infrastructure/IntegrationEvents/TaskItems/**",
            "src/CleanSlices.Infrastructure/IntegrationEvents/Users/**",
            "docs/samples.md"
          ]
        },
        {
          "condition": "(!result)",
          "exclude": [
            "src/CleanSlices.Api/Extensions/ResultExtensions.cs",
            "src/CleanSlices.Core/Shared/Error.cs",
            "src/CleanSlices.Core/Shared/Result.cs",
            "tests/CleanSlices.Core.Tests/ResultAssertions.cs",
            "docs/error-handling.result.md"
          ]
        },
        {
          "condition": "(!integration_events)",
          "exclude": [
            "src/CleanSlices.Infrastructure/IntegrationEvents/**",
            "src/CleanSlices.Infrastructure/EventHandlers/TaskItems/PublishTaskCompletedHandler.cs",
            "src/CleanSlices.Infrastructure/EventHandlers/Users/PublishUserCreatedHandler.cs",
            "src/CleanSlices.Infrastructure/EventHandlers/Users/PublishUserDeletedHandler.cs"
          ]
        },
        {
          "condition": "(!outbox)",
          "exclude": [
            "src/CleanSlices.Infrastructure/Outbox/**",
            "tests/CleanSlices.Api.Tests/Outbox/**",
            "tests/CleanSlices.Api.Tests/Features/Tasks/TaskIntegrationEventsTests.cs",
            "tests/CleanSlices.Api.Tests/Features/Users/UserIntegrationEventsTests.cs"
          ]
        },
        {
          "condition": "(!inbox)",
          "exclude": [
            "src/CleanSlices.Infrastructure/Inbox/**",
            "tests/CleanSlices.Api.Tests/Inbox/**"
          ]
        },
        {
          "condition": "(result)",
          "exclude": [
            "src/CleanSlices.Core/Shared/Exceptions.cs",
            "docs/error-handling.md"
          ],
          "rename": {
            "docs/error-handling.result.md": "docs/error-handling.md"
          }
        }
      ]
    }
  ],
  "SpecialCustomOperations": {
    "**/*.md": {
      "operations": [
        {
          "type": "conditional",
          "configuration": {
            "if": [ "<!--#if" ],
            "else": [ "<!--#else" ],
            "elseif": [ "<!--#elseif" ],
            "endif": [ "<!--#endif" ],
            "trim": true,
            "wholeLine": true
          }
        }
      ]
    },
    "**/*.http": {
      "operations": [
        {
          "type": "conditional",
          "configuration": {
            "if": [ "# #if" ],
            "else": [ "# #else" ],
            "elseif": [ "# #elseif" ],
            "endif": [ "# #endif" ],
            "trim": true,
            "wholeLine": true
          }
        }
      ]
    }
  }
}
